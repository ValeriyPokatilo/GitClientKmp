ENABLE_PREVIEWS = YES
DEVELOPMENT_ASSET_PATHS = "src/Preview Content"
BUILD_LIBRARY_FOR_DISTRIBUTION = YES
INSTALL_PATH = $(LOCAL_LIBRARY_DIR)/Frameworks
SKIP_INSTALL = YES
PRODUCT_BUNDLE_IDENTIFIER = dev.icerock.boilerplate.DesignSystem
PRODUCT_NAME = DesignSystem
ENABLE_MODULE_VERIFIER = YES
SWIFT_INSTALL_OBJC_HEADER = NO
MACH_O_TYPE = mh_dylib
USER_HEADER_SEARCH_PATHS = $(SRCROOT)/objc
DYLIB_INSTALL_NAME_BASE = @rpath

// см Assets.swift для деталей почему выключено
ASSETCATALOG_COMPILER_APPICON_NAME =
ASSETCATALOG_COMPILER_GENERATE_SWIFT_ASSET_SYMBOL_EXTENSIONS = NO
ASSETCATALOG_COMPILER_GLOBAL_ACCENT_COLOR_NAME =
